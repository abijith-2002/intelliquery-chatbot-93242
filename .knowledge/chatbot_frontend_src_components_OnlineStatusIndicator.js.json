{"is_source_file": true, "format": "JavaScript (React component)", "description": "This file defines a React functional component named OnlineStatusIndicator. It periodically checks the backend API root URL to determine the API's online status, displaying a colored indicator (green for online, red for offline, gray for unknown). It allows users to click the indicator to open a dialog to change the API base URL for the current session. The component manages its state with React hooks, performs fetch requests to verify backend status, and integrates with utility functions to get/set the API base URL.", "external_files": ["./OnlineStatusIndicator.css", "./ModalDialog", "../utils/apiBase"], "external_methods": ["getApiBase", "setApiBase"], "published": [], "classes": [], "methods": [{"name": "OnlineStatusIndicator (function component)", "description": "Main exported React component that renders the online status indicator and manages polling logic."}, {"name": "checkStatus", "description": "An asynchronous inner function that fetches the API root URL to determine if the backend is online."}, {"name": "handleOpen", "description": "Opens the dialog to change the API base URL and resets the current base from getApiBase()."}, {"name": "handleClose", "description": "Closes the dialog without changes."}, {"name": "handleConfirm", "description": "Handles confirmation from the dialog, setting the new API base URL via setApiBase() and triggering a re-poll."}, {"name": "OnlineStatusIndicator({ intervalMs = 5000, className = '', style = {} })", "scope": "", "scopeKind": "", "description": "unavailable"}], "calls": ["fetch", "setApiBase", "getApiBase"], "search-terms": ["OnlineStatusIndicator", "backend API status", "React useEffect polling", "API base URL change"], "state": 2, "file_id": 110, "knowledge_revision": 406, "git_revision": "3dfad313168becff0c781a0f9bbac84360d35b09", "revision_history": [{"393": ""}, {"406": "3dfad313168becff0c781a0f9bbac84360d35b09"}], "ctags": [{"_typ