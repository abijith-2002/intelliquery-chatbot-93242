{
  "name": "intelliquery-chatbot-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "cross-fetch": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^8.0.7",
    "react-scripts": "^5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write src/**/*.{js,jsx,css,md}"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "cross-env": "^7.0.3",
    "prettier": "^2.8.8"
  },
  "keywords": [
    "react",
    "chatbot",
    "ai",
    "gemini",
    "rag",
    "intelliquery"
  ],
  "description": "Modern React frontend for IntelliQuery AI chatbot with Gemini and RAG integration",
  "author": "IntelliQuery Team",
  "license": "MIT"
}
